---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { href } from '../lib/catalog';
import { lang, t } from '../lib/i18n';
import { Download, RotateCw, Smartphone } from '@lucide/astro';

/** Same file name in every release, so the link never changes. */
const APK_URL = 'https://github.com/aym3ntn-ai/classeuri/releases/latest/download/classeuri.apk';

interface Props {
  title?: string;
  /** The PDF viewer fills the window and brings its own chrome. */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${t.app.name}` : `${t.app.name} · ${t.app.tagline}`;
const themes = [
  { value: 'system', label: t.settings.themeSystem },
  { value: 'light', label: t.settings.themeLight },
  { value: 'dark', label: t.settings.themeDark },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={t.app.tagline} />
    <meta name="theme-color" content="#F2F3F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1116" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/png" href={href('icon.png')} />
    <!-- Installable app: manifest for Android and desktop, Apple tags for iOS -->
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={t.app.name} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <title>{fullTitle}</title>
    <script is:inline>
      // Before first paint, so a stored theme never flashes the other one.
      try {
        const theme = localStorage.getItem('classeuri.theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <div class="ptr" data-ptr={JSON.stringify(t.pullToRefresh)} aria-live="polite">
            <RotateCw class="ptr-icon" size={18} stroke-width={2.2} aria-hidden="true" />
            <span data-ptr-label>{t.pullToRefresh.pull}</span>
          </div>
          <header class="site-header">
            <a class="brand" href={href()}>
              <img src={href('icon.png')} alt="" width="30" height="30" />
              {t.app.name}
            </a>
            <div class="segmented" role="group" aria-label={t.settings.theme} data-theme-switch>
              {themes.map((theme) => (
                <button type="button" data-value={theme.value} aria-pressed="false">
                  {theme.label}
                </button>
              ))}
            </div>
          </header>
          <main class="page">
            <slot />
          </main>
          <footer class="site-footer install-only">
            <a href={href('installer/')}>
              <Smartphone size={20} stroke-width={1.8} aria-hidden="true" />
              {t.install.footerLink}
            </a>
            <a href={APK_URL}>
              <Download size={20} stroke-width={1.8} aria-hidden="true" />
              {t.app.androidDownload}
            </a>
          </footer>
        </>
      )
    }
    <script is:inline define:vars={{ swUrl: href('sw.js'), scope: href() }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register(swUrl, { scope }).catch(() => {}));
      }
    </script>
    <script>
      import '../scripts/pull-to-refresh.ts';
    </script>
    <script>
      const group = document.querySelector<HTMLElement>('[data-theme-switch]');
      if (group) {
        const read = () => {
          try {
            return localStorage.getItem('classeuri.theme') ?? 'system';
          } catch {
            return 'system';
          }
        };
        const apply = (value: string) => {
          if (value === 'system') delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = value;
          for (const button of group.querySelectorAll('button')) {
            button.setAttribute('aria-pressed', String(button.dataset.value === value));
          }
        };
        apply(read());
        group.addEventListener('click', (event) => {
          const value = (event.target as HTMLElement).closest('button')?.dataset.value;
          if (!value) return;
          try {
            localStorage.setItem('classeuri.theme', value);
          } catch {}
          apply(value);
        });
      }
    </script>
  </body>
</html>
