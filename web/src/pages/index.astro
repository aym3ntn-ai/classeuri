---
import { ChevronRight, X } from '@lucide/astro';
import CourseIcon from '../components/CourseIcon.astro';
import Base from '../layouts/Base.astro';
import { courseHref, href, loadCatalog } from '../lib/catalog';
import { t } from '../lib/i18n';

const catalog = loadCatalog();
const semesters = catalog.years.flatMap((year) =>
  year.semesters.map((semester) => ({ key: `${year.id}/${semester.id}`, year, semester })),
);
// The most recent semester is the one being studied.
const current = semesters.at(-1)?.key;
---

<Base>
  <p class="mono label" data-current-label>
    {semesters.length > 0 ? `${semesters.at(-1)!.year.label} · ${semesters.at(-1)!.semester.label}` : ''}
  </p>
  <h1 class="screen-title">{t.home.title}</h1>

  <div class="ios-banner install-only" data-ios-banner hidden>
    <a href={href('installer/')}>
      <img src={href('apple-touch-icon.png')} alt="" width="40" height="40" />
      <span>
        <b>{t.install.banner}</b>
        <span class="caption">{t.install.bannerAction}</span>
      </span>
      <ChevronRight size={20} stroke-width={2} aria-hidden="true" />
    </a>
    <button type="button" data-dismiss aria-label={t.install.dismiss}>
      <X size={18} stroke-width={2} aria-hidden="true" />
    </button>
  </div>

  {
    semesters.length > 1 && (
      <div class="switcher" role="group" aria-label={t.home.chooseSemester}>
        {semesters.map((s) => (
          <button type="button" data-semester-tab={s.key} aria-pressed={s.key === current ? 'true' : 'false'}>
            {s.year.label} · {s.semester.label}
          </button>
        ))}
      </div>
    )
  }

  {
    semesters.length === 0 && (
      <div class="empty">
        <p>{t.home.empty}</p>
        <p class="caption">{t.home.emptyHint}</p>
      </div>
    )
  }

  {
    semesters.map((s) => (
      <section data-semester={s.key} data-label={`${s.year.label} · ${s.semester.label}`} hidden={s.key !== current}>
        <h2 class="section-title">{t.home.myCourses}</h2>
        <div class="grid">
          {s.semester.courses.map((course) => (
            <a class="tile" href={courseHref(course)} style={`--accent:${course.accent};--on-accent:${course.onAccent}`}>
              <CourseIcon name={course.icon} />
              <span class="tile-text">
                <span class="mono">{course.code}</span>
                <span class="tile-name">{course.name}</span>
                <span class="tile-meta">{t.home.tileMetaWeb(course.documentCount)}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>

<script>
  // iPhone and iPad visitors in a browser tab get a pointer to the install page.
  const banner = document.querySelector<HTMLElement>('[data-ios-banner]');
  const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.userAgent.includes('Macintosh') && navigator.maxTouchPoints > 1);
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as { standalone?: boolean }).standalone === true;
  let dismissed = false;
  try {
    dismissed = localStorage.getItem('classeuri.iosBanner') === 'dismissed';
  } catch {}
  if (banner && isIOS && !standalone && !dismissed) {
    banner.hidden = false;
    banner.querySelector('[data-dismiss]')!.addEventListener('click', () => {
      banner.hidden = true;
      try {
        localStorage.setItem('classeuri.iosBanner', 'dismissed');
      } catch {}
    });
  }

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-semester-tab]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-semester]')];
  const label = document.querySelector<HTMLElement>('[data-current-label]');
  const KEY = 'classeuri.semester';

  function show(key: string) {
    const target = sections.find((s) => s.dataset.semester === key);
    if (!target) return;
    for (const section of sections) section.hidden = section !== target;
    for (const tab of tabs) tab.setAttribute('aria-pressed', String(tab.dataset.semesterTab === key));
    if (label) label.textContent = target.dataset.label ?? '';
  }

  try {
    const stored = localStorage.getItem(KEY);
    if (stored) show(stored);
  } catch {}

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const key = tab.dataset.semesterTab!;
      show(key);
      try {
        localStorage.setItem(KEY, key);
      } catch {}
    });
  }
</script>

<style>
  .ios-banner {
    display: flex;
    align-items: center;
    margin-top: 16px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .ios-banner a {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 10px 6px 10px 12px;
  }

  .ios-banner img {
    border-radius: 10px;
  }

  .ios-banner a > span {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .ios-banner button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    margin-right: 6px;
    color: var(--ink-3);
  }

  .label {
    margin: 10px 0 0;
    color: var(--ink-2);
  }

  .switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .switcher button {
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-weight: 600;
    font-size: 14px;
    color: var(--ink-2);
  }

  .switcher button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-ink);
  }

  .section-title {
    margin: 26px 0 12px;
    font-size: 17px;
    line-height: 22px;
    font-weight: 700;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 12px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 176px;
    padding: 14px;
    border-radius: 18px;
    background: var(--accent);
    color: var(--on-accent);
    transition: transform 0.12s ease;
  }

  .tile:hover {
    transform: translateY(-2px);
  }

  .tile-text {
    display: flex;
    flex-direction: column;
  }

  .tile .mono {
    opacity: 0.85;
  }

  .tile-name {
    margin-top: 2px;
    font-size: 17px;
    line-height: 22px;
    font-weight: 700;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile-meta {
    margin-top: 4px;
    font-size: 12.5px;
    opacity: 0.9;
  }

  .empty {
    margin-top: 40px;
    color: var(--ink-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile {
      transition: none;
    }
  }
</style>
