---
import Base from '../layouts/Base.astro';
import { href } from '../lib/catalog';
import { t } from '../lib/i18n';
---

<Base title={t.errors.pageNotFound}>
  <h1 class="screen-title" style="margin-top:40px">{t.errors.pageNotFound}</h1>
  <p style="margin-top:16px">
    <a href={href()} style="text-decoration:underline;font-weight:600">{t.errors.backHome}</a>
  </p>
</Base>
